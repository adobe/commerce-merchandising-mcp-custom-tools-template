# Copy to .env and configure with aio app use. Never commit .env.
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

# Must match the environment that issued the IMS access token.
IMS_ENV=<%= imsEnv %>
# A nonempty value overrides the action's generated allowlist.
# An empty value retains that default (an empty default accepts any valid token).
IMS_CLIENT_ALLOWLIST=<%= allowlist.join(',') %>
