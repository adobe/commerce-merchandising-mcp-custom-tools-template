{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error"
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "plugins": ["jest"],
      "env": { "jest": true },
      "extends": ["plugin:jest/recommended"]
    }
  ]
}
