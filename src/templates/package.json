{
  "version": "0.1.0",
  "private": true,
  "description": "IMS-authenticated custom MCP tools for Adobe I/O Runtime",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest --runInBand",
    "lint": "eslint .",
    "e2e": "jest --runInBand --coverage=false --testMatch \"**/e2e/**/*.test.js\""
  },
  "dependencies": {
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/aio-lib-ims": "^8.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^30.5.2"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "actions/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  }
}
